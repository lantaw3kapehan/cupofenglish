#!/bin/bash
# 2815: rebuild app.min.html (compact copy, faster-download pilot) whenever app.html is committed.
# install: cp tools/hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit ; needs terser@5 and csso@5 (NODE_PATH below)
if git diff --cached --name-only | grep -qx 'app.html'; then
  export NODE_PATH="/home/claude/mintools/node_modules${NODE_PATH:+:$NODE_PATH}"
  if node tools/compact.js app.html app.min.html; then cp app.min.html appm.html; git add app.min.html appm.html   # 2945: the host serves a stale app.min.html; the app reads appm.html
  else echo "app.min.html not rebuilt: the pilot account falls back to app.html until it is" >&2; fi
fi
exit 0
