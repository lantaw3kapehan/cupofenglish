+// 25 Oct · R1 · BIRTHDATE on "Edit student" (saveStudent into an existing row, args = [token, f, row]):
+//   f.birthClear (1/true) → the birthdate is removed: birth "" + birthClear 1, nothing else can clear it.
+//   otherwise an empty / missing birth, or f.birthKeep → "keep what is stored": birthKeep 1, and an empty birth is
+//   filled with the stored cell from the DATABASE copy when the copy's row has the same code (Google then writes the
+//   same date back, and with SERVER-BIRTHDATE pasted it leaves the cell alone). A new full date is passed on as it is.
+//   New rows (row 0) are not touched.
+const stuBirthOn = (x: unknown) => x === true || x === 1 || x === "1" || x === "true";
+function stuBirthNeedsStored(args: any) {
+  if (!Array.isArray(args) || !args[1] || typeof args[1] !== "object" || !(Number(args[2]) > 0)) return false;
+  const f = args[1]; return !stuBirthOn(f.birthClear) && String(f.birth ?? "").trim() === "";
+}
+function stuBirthCell(x: unknown): string | null {
+  if (x === null || x === undefined) return null; const t = String(x).trim(); if (!t) return null;
+  return /^\d{4}-\d{2}-\d{2}T00:00:00/.test(t) ? t.slice(0, 10) : t;
+}
+function stuBirthGuard(args: any, stored: string | null) {
+  if (!Array.isArray(args) || !args[1] || typeof args[1] !== "object" || Array.isArray(args[1]) || !(Number(args[2]) > 0)) return args;
+  const f: any = Object.assign({}, args[1]);
+  if (stuBirthOn(f.birthClear)) { f.birth = ""; f.birthClear = 1; delete f.birthKeep; }
+  else {
+    delete f.birthClear; const b0 = String(f.birth ?? "").trim();
+    if (!b0 || stuBirthOn(f.birthKeep)) { f.birthKeep = 1; f.birth = b0 || stored || ""; }
+    else delete f.birthKeep;
+  }
+  return [args[0], f, ...args.slice(2)];
+}
